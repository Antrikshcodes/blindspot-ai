# ============================================================================
# Blindspot AI Frontend Environment Template (frontend/.env.example)
# Copy this file to frontend/.env.local (never commit real credentials)
# ============================================================================

# Clerk Authentication Publishable Key
# Obtain from your Clerk Dashboard (https://dashboard.clerk.com) -> API Keys.
# Must start with pk_test_ or pk_live_.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# Backend API Configuration
# In local development:
# - Leave VITE_API_BASE_URL empty so requests to /api are proxied by Vite to the backend.
# - VITE_BACKEND_URL controls the target of the /api proxy (defaults to http://localhost:3000).
# In production:
# - Set VITE_API_BASE_URL to your deployed backend origin if hosted separately.
VITE_BACKEND_URL=http://localhost:3000
# VITE_API_BASE_URL=https://api.yourdomain.com

# Frontend Dev Server Port (defaults to 5173 to avoid collision with backend on 3000)
VITE_PORT=5173

