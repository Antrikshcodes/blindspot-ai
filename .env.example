# See backend/.env.example for the full Phase 01 configuration.
# Backend loads .env from backend/ when started with npm run dev there.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
AI_PROVIDER=replit
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=45000
AI_MAX_ATTEMPTS=2
AI_API_KEY=
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
KAGGLE_ENABLED=false
KAGGLE_USERNAME=
KAGGLE_KEY=
CACHE_TTL=900
EXTERNAL_TIMEOUT_MS=8000
PROVIDER_CONCURRENCY=3
PROVIDER_PAGE_SIZE=5
RESOURCE_RESULT_LIMIT=24
