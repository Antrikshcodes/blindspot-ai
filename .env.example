# ============================================================================
# Blindspot AI Root Environment Template (.env.example)
# Never commit real credentials or actual .env files to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Local Docker Compose database settings (use a unique local-only password)
POSTGRES_USER=blindspot_user
POSTGRES_PASSWORD=replace_with_a_local_only_password
POSTGRES_DB=blindspot_db

# Backend Configuration (backend/.env)
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Clerk Authentication (Backend secret key for verifying tokens)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_secret_here

# AI Provider Configuration (replit | openai | disabled)
AI_PROVIDER=replit
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=45000
AI_MAX_ATTEMPTS=2
AI_API_KEY=

# Resource Intelligence Provider Credentials (optional)
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
KAGGLE_ENABLED=false
KAGGLE_USERNAME=
KAGGLE_KEY=

# Service Limits & Caching
CACHE_TTL=900
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
API_RATE_LIMIT=120
AI_RATE_LIMIT=10
EXTERNAL_TIMEOUT_MS=8000
PROVIDER_CONCURRENCY=3
PROVIDER_PAGE_SIZE=5
RESOURCE_RESULT_LIMIT=24

# ----------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ----------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
VITE_BACKEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
VITE_PORT=5173

# ----------------------------------------------------------------------------
# Quick Start Commands
# ----------------------------------------------------------------------------
# 1. Start Backend:  cd backend && npm run dev (runs on port 3000)
# 2. Start Frontend: cd frontend && npm run dev (runs on port 5173, proxies /api -> :3000)
