// Blindspot AI — Database Schema
// Team Null Theory | CoNSTruct 2.0 (Replit × Newton School of Technology)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@map("users")
}

model Project {
  id                 String          @id @default(cuid())
  name               String
  problemStatement   String
  targetAudience     String
  proposedSolution   String?
  productDescription String?
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  assumptions        Assumption[]
  interviews         Interview[]
  feedbackNotes      FeedbackNote[]
  contradictions     Contradiction[]
  experiments        Experiment[]

  @@map("projects")
}

model Assumption {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statement        String
  category         String          // PROBLEM | CUSTOMER | SOLUTION | MONETIZATION
  explanation      String?
  impactScore      Int             @default(3) // 1 to 5
  uncertaintyScore Int             @default(3) // 1 to 5
  compositeRisk    Int             @default(9) // impactScore * uncertaintyScore (1 to 25)
  isLethal         Boolean         @default(false) // compositeRisk >= 15
  validationMethod String?
  status           String          @default("UNVERIFIED") // UNVERIFIED | SUPPORTED | INVALIDATED
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  interviews       Interview[]
  evidence         Evidence[]
  contradictions   Contradiction[]
  experiments      Experiment[]

  @@map("assumptions")
}
