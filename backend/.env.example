# Phase 01 backend. Placeholders only; never commit a real .env.
# Replit supplies DATABASE_URL and managed AI variables automatically.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Provisioned by Replit-managed Clerk setup. Missing keys block private routes
# with AUTH_NOT_READY in every environment. Never use a user-ID header.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY is provisioned for a future web sign-in integration.

# replit | openai | disabled. Disabled still permits CRUD and explicit-query
# resource searches with explain=false; AI-only endpoints return 503.
AI_PROVIDER=replit
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=45000
AI_MAX_ATTEMPTS=2
AI_API_KEY=
AI_BASE_URL=
# Automatically supplied by Replit AI Integrations:
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional; public GitHub/Hugging Face searches also work without tokens.
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
KAGGLE_ENABLED=false
KAGGLE_USERNAME=
KAGGLE_KEY=

# Seconds; cache max 100 search result sets per process.
CACHE_TTL=900
API_RATE_LIMIT=120
AI_RATE_LIMIT=10
EXTERNAL_TIMEOUT_MS=8000
PROVIDER_CONCURRENCY=3
PROVIDER_PAGE_SIZE=5
RESOURCE_RESULT_LIMIT=24
# Optional complete weight object; unknown signals contribute no positive score.
# RANK_WEIGHTS={"relevance":0.4,"compatibility":0.15,"documentation":0.1,"maintenance":0.08,"licenseAvailability":0.02,"maturity":0,"functional":0.2,"integrationEase":0.05}
