# ==========================================
# Blindspot AI — Backend Environment Variables
# ==========================================

PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Database Configuration (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# AI Provider Configuration (Phase 3 onwards)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Authentication Configuration (Phase 9 onwards)
JWT_SECRET=super_secret_development_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
