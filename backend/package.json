{
  "name": "blindspot-ai-backend",
  "version": "1.0.0",
  "description": "Backend API server, persistence layer, and AI orchestration engine for Blindspot AI",
  "main": "dist/phase01/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.phase01.json",
    "start": "node dist/phase01/server.js",
    "dev": "tsx watch src/phase01/server.ts",
    "test": "vitest run tests/phase01 --maxWorkers=1",
    "test:watch": "vitest tests/phase01",
    "test:legacy": "node scripts/test.mjs",
    "build:legacy": "tsc",
    "dev:legacy": "tsx watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/phase01/db/migrate.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "blindspot-ai",
    "validation",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Team Null Theory",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "openai": "^7.53.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "prisma": "^6.4.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
